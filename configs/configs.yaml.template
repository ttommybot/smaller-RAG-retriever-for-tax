# RAG for Tax 项目配置文件（模板）
#
# 使用说明：
# 1. 复制本文件为 configs.yaml 或保留为模板参考
# 2. 敏感信息（如 API key）请放入 configs_local.yaml 文件中
# 3. configs_local.yaml 不会被提交到 Git

project_name: "rag_for_tax"

paths:
  raw_data_dir: "data/raw"
  processed_data_dir: "data/processed"
  vector_db_dir: "vectordb"

chunking:
  chunk_size: 300
  chunk_overlap: 100
  min_chunk: 100

embedding:
  model_large_name: "BAAI/bge-large-zh-v1.5"
  model_small_name: "sentence-transformers/all-MiniLM-L6-v2"
  model_student_name: "sentence-transformers/all-MiniLM-L6-v2"
  model_teacher_name: "BAAI/bge-reranker-v2-gemma"

retrieval:
  top_k: 5

models:
  # 生成器后端类型：dummy / huggingface / openai / ollama
  generator_backend: "huggingface"
  # 生成器模型名称
  generator_model_name: "Qwen/Qwen2.5-7B-Instruct"
  # HuggingFace API Key（留空，请在 configs_local.yaml 中填写）
  huggingface_api_key: ""

app:
  show_sources: true
